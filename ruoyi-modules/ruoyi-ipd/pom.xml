<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.ruoyi</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-ipd</artifactId>

    <description>
        ipd IPD 产品经理管理系统业务模块
    </description>

    <dependencies>
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-idempotent</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-ratelimiter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <!-- AiModelConfigService（P3-A批）字段加密需要 EncryptUtils；版本随 BOM -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-encrypt</artifactId>
        </dependency>

        <!-- ROOT-R2-P0-2：NotificationDispatcher 异步重试队列依赖 Redisson 延迟队列 -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-redis</artifactId>
        </dependency>

        <!-- W20-B：Notification 中间件化 EMAIL 真实通道依赖 Spring Boot Mail（JavaMailSender） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- W20-B：Notification 中间件化 WEBSOCKET 真实通道依赖 ruoyi-common-websocket -->
        <dependency>
            <groupId>org.ruoyi</groupId>
            <artifactId>ruoyi-common-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 构建收口卡 c7767e3a（2026-09-06 晚）：P4-2.1 临时排除块（ContributionService 编译排除 +
                 ComplianceServiceTest / ContributionServiceTest 测试排除）已全部移除，模块回归无排除自洽构建；
                 排除成因与验证证据见看板该卡注记。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- [2026-09-08 治理] 本段曾被三个卡各自「临时」追加，累积豁免 5 个测试类，
                         且旧注释自称「仅在 worktree 内追加排除，不影响 main 分支 HEAD 字节」——实际
                         已随 4feb8ec9 / 221f6c30 / f1ce2db7 进 main 并长期生效。后果：这 5 个类不编译、
                         不执行、一份 surefire 报告不出，mvn 依旧 BUILD SUCCESS；214 个 *Test.java 只编出
                         209 个 class，任何红名单比对都看不见它们（静默跳过即假绿）。

                         本轮实测已撤销其中 3 条（Api03AcceptanceTest / DefectBAdviceAcceptanceTest /
                         IpdAuthChangePasswordExceptionTest）：豁免理由（W20-B「兄弟会话在途编译错误」）
                         早已消解，撤销后编译通过、测试回归，净增 16 个测试（1893 → 1909）且红数未增。
                         撤销同时暴露出 Api03AcceptanceTest 的 stub 仍打在 requireInternal() 上，而
                         Controller 在 SEC-AUTH-DEADLOCK 修复中已改调 requireInternalEvenIfPasswordScope()
                         ——实现漂移被豁免掩盖，已修（该类 5/5 绿）。

                         下面 2 条经实测确认仍真编译失败，暂予保留，但不再是隐性豁免：
                         已在 scripts/ci/ipd-test-red-baseline.txt 以 exempt_class 显式登记，并由
                         .github/workflows/ipd-test-gate.yml 强制「每个测试类都必须产出报告，否则阻断」，
                         未登记的静默跳过会被当场拦下。台账见 OD-AM-06。
                         修好后请同时删除此处 testExclude 与基线里的 exempt_class 行。 -->
                    <testExcludes>
                        <!-- KpiSharedConfirmControllerTest：BaseMapper.insert(T) 与 insert(Collection 泛型重载)
                             重载歧义未消解。实测报错「对 insert 的引用不明确」「对 updateById 的引用不明确」
                             及多处「找不到符号」（221f6c30 追加豁免）。 -->
                        <!-- P312AcceptanceTest：SharedKpiController 构造器漂移。实测报错「无法将类
                             SharedKpiController 中的构造器应用到给定类型」（221f6c30 追加豁免）。
                             注意：本类与 KpiSharedConfirmControllerTest 同属 KPI 共担域，被豁免意味着
                             该域的改动长期缺少这两道回归保护。 -->
                        <testExclude>**/KpiSharedConfirmControllerTest.java</testExclude>
                        <testExclude>**/P312AcceptanceTest.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
