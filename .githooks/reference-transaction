#!/bin/sh
# 分支引用事务护栏：分支被强制移动/删除（会孤儿化 commit）时，自动把移动前的真 tip
# 快照到 refs/snapshot/<分支>-<时间戳>-<pid>，使孤儿 commit 保持可达、不被 GC。
#
# 实测边界（2026-09-08 git 2.50）：
# - git 在 committed 阶段传给本 hook 的 old 对强制移动（branch -f 等）是全零，
#   不可依赖；因此本 hook 只在 prepared 阶段工作——此刻引用尚未更新，
#   `git rev-parse "$ref"` 读到的就是移动前真 tip，与强制语义无关。
# - git reset 不触发本 hook（实测），reset 兜底由 scripts/git-snapshot-watchdog.sh 负责。
# - 正常前进（fast-forward/commit）不产生快照，避免 ref 膨胀。
# - 本 hook 永远 exit 0：只做兜底快照，绝不阻断任何 git 操作。
stage="$1"
[ "$stage" = "prepared" ] || exit 0
ZERO=0000000000000000000000000000000000000000
while read -r old new ref; do
  case "$ref" in refs/heads/*) ;; *) continue ;; esac
  cur=$(git rev-parse --verify -q "$ref" 2>/dev/null) || cur=""
  [ -n "$cur" ] && [ "$cur" != "$ZERO" ] || continue          # 新建分支，无孤儿风险
  [ "$cur" != "$new" ] || continue                             # 无实际移动
  if [ -n "$new" ] && [ "$new" != "$ZERO" ]; then
    git merge-base --is-ancestor "$cur" "$new" 2>/dev/null && continue  # 正常前进，无孤儿风险
  fi
  short=$(printf '%s' "$ref" | sed 's|refs/heads/||; s|/|-|g')
  ts=$(date +%Y%m%dT%H%M%S 2>/dev/null) || ts=$$
  snap="refs/snapshot/$short-$ts-$$"
  (
    sleep 0.5
    git update-ref "$snap" "$cur" >/dev/null 2>&1
  ) </dev/null >/dev/null 2>&1 &
done
exit 0
