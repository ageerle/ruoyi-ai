diff --git a/ruoyi-admin/src/main/resources/application-prod.yml b/ruoyi-admin/src/main/resources/application-prod.yml
--- a/ruoyi-admin/src/main/resources/application-prod.yml
+++ b/ruoyi-admin/src/main/resources/application-prod.yml
@@ -284,3 +284,21 @@
   # prod 必须通过环境变量 API_DECRYPT_PRIVATE_KEY 注入 RSA 私钥（原 yml 字面量已从 git 历史清除，视为泄露需轮换）
   # 留空时即便 enabled=true 也会因空私钥启动失败（fail-fast 语义）
   privateKey: ${API_DECRYPT_PRIVATE_KEY:}
+
+--- # P1 项3（owner 2026-09-05 指令，第 2 批 prod 覆盖）：显式 pin 三个「当前靠父基线继承」的安全默认
+# 说明：这三项在 prod 里本来就没有段，值靠 application.yml 继承，语义上已经是安全的；
+# 本段的作用是「显式化 + 防继承翻转」——父基线一旦被改，prod 不会静默跟着变危险。
+demo:
+  # 父基线 application.yml 已默认 false（R8-P0-2）；prod 显式 false，防止父级被翻回 true 后 prod 静默开启写拦截
+  enabled: false
+
+springdoc:
+  api-docs:
+    # 父基线为 true；prod 必须关闭，否则 /v3/api-docs 与 swagger-ui 在生产环境对外暴露全部接口面（owner 项3 唯一真缺项）
+    enabled: false
+  swagger-ui:
+    enabled: false
+
+sa-token:
+  # 父基线已是 ${SA_TOKEN_JWT_SECRET_KEY:} 无默认；prod 显式重申，密钥只能由 env 注入（历史泄露密钥 a8a70ad9 已声明作废，见凭证轮换处置）
+  jwt-secret-key: ${SA_TOKEN_JWT_SECRET_KEY:}
